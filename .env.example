# Copie para .env e preencha. NUNCA versione o .env.

# Banco de dados
TEKCONDO_DB_USER=tekcondo
TEKCONDO_DB_PASSWORD=troque-por-uma-senha-forte

# Segredo HMAC dos tokens JWT — mínimo 32 bytes. Gere com: openssl rand -base64 48
TEKCONDO_JWT_SECRET=

# Cookie de sessão só via HTTPS. Use true em produção (com TLS); false apenas em http://localhost.
TEKCONDO_COOKIE_SECURE=false

# Documentação Swagger (desative em produção, se não for necessária)
TEKCONDO_SWAGGER_ENABLED=true

# Administrador da plataforma criado na primeira execução (senha: 10+ caracteres, letras e números).
# Após o primeiro acesso, remova estes valores do ambiente.
TEKCONDO_BOOTSTRAP_ADMIN_EMAIL=
TEKCONDO_BOOTSTRAP_ADMIN_PASSWORD=

# URL pública do sistema (usada nos links de convite e redefinição de senha enviados por e-mail)
TEKCONDO_PUBLIC_URL=http://localhost:8081

# E-mail: smtp (produção) ou file (desenvolvimento: grava as mensagens em arquivo, nada é enviado)
TEKCONDO_MAIL_PROVIDER=smtp
TEKCONDO_MAIL_FROM=Tek Condomínio <nao-responda@suaempresa.com.br>
TEKCONDO_SMTP_HOST=
TEKCONDO_SMTP_PORT=587
TEKCONDO_SMTP_USER=
TEKCONDO_SMTP_PASSWORD=

# Lembretes diários (notificações): horário no formato cron do Spring
# TEKCONDO_JOBS_REMINDERS_CRON=0 0 7 * * *

# Limite de tentativas por IP em login/recuperação de senha (por instância; aplique também no proxy se houver várias)
# TEKCONDO_AUTH_RATE_LIMIT=20
# TEKCONDO_AUTH_RATE_WINDOW=PT5M

# LGPD: dias após o fim da autorização para anonimizar registros de portaria; horário da rotina
# TEKCONDO_VISITOR_RETENTION_DAYS=180
# TEKCONDO_JOBS_RETENTION_CRON=0 30 3 * * *

# Fuso das datas de negócio (vencimento, atraso, "hoje")
# TEKCONDO_TIME_ZONE=America/Sao_Paulo

# Opcionais
# TEKCONDO_ACCESS_TOKEN_TTL=PT15M
# TEKCONDO_REFRESH_TOKEN_TTL=P7D
# TEKCONDO_MAX_FAILED_LOGINS=5
# TEKCONDO_LOCKOUT_DURATION=PT15M
# TEKCONDO_CORS_ORIGINS=https://app.suaempresa.com.br
